# Copy to .env and fill in. Never commit .env.

  # Claude Platform API (https://platform.claude.com). Required for AI features.
  ANTHROPIC_API_KEY=

  # Optional. Claude model ID; defaults to claude-opus-5.
  CLAUDE_MODEL=claude-opus-5

  # Optional. Override the API base URL, e.g. for a proxy. Leave empty for the default.
  ANTHROPIC_BASE_URL=