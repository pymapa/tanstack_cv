{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.82",
        "--headless",
        "--isolated",
        "--browser",
        "chromium",
        "--viewport-size",
        "1440x900",
        "--allowed-origins",
        "http://localhost:3000;http://localhost:3001"
      ]
    }
  }
}
